name = "mldong/moon-file-storage-verify"

version = "0.1.0"

license = "Apache-2.0"

preferred_target = "wasm"

description = "Shared platform contract suite for moon-file-storage"

import {
  "mldong/moon-hutool@0.1.4",
  "mldong/moon-file-storage@0.1.0",
  "mldong/moon-file-storage-local@0.1.0",
  "mldong/moon-file-storage-recorder-file@0.1.0",
  "moonbitlang/async@0.22.4",
}

readme = "README.md"

repository = "https://github.com/mldong/moon-file-storage"

keywords = [
  "moonbit",
  "file-storage",
  "s3",
  "qiniu",
  "kodo",
  "ftp",
  "upload",
  "presigned",
]
