name = "mldong/moon-file-storage-qiniu"

version = "0.1.2"

license = "Apache-2.0"

preferred_target = "wasm"

description = "Qiniu Kodo platform adapter for moon-file-storage"

import {
  "mldong/moon-hutool@0.1.7",
  "mldong/moon-file-storage@0.1.2",
  "mldong/moon-kodo@0.1.3",
  "moonbitlang/async@0.22.5",
}

readme = "README.md"

repository = "https://github.com/mldong/moon-file-storage"

keywords = [
  "moonbit",
  "file-storage",
  "s3",
  "qiniu",
  "kodo",
  "ftp",
  "upload",
  "presigned",
]
