name = "mldong/moon-file-storage-ftp"

version = "0.1.2"

license = "Apache-2.0"

preferred_target = "wasm"

description = "FTP platform adapter for moon-file-storage"

import {
  "mldong/moon-file-storage@0.1.2",
  "PaiGack/ftp@0.2.3",
  "moonbitlang/async@0.22.5",
}

readme = "README.md"

repository = "https://github.com/mldong/moon-file-storage"

keywords = [
  "moonbit",
  "file-storage",
  "s3",
  "qiniu",
  "kodo",
  "ftp",
  "upload",
  "presigned",
]
